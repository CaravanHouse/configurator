# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Куда присылать заявки: id чата или группы. Узнать — написать боту /id
ADMIN_CHAT_ID=
PORT=3000
# 1, если сервер стоит за прокси (Render, Nginx) — нужно для лимита заявок по IP. На Railway включается само, 0 — выключить
TRUST_PROXY=
# Папка для данных. На Railway подключите Volume и укажите его путь, например /data. По умолчанию ./data
DATA_DIR=
