# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Куда присылать заявки: id чата или группы. Узнать — написать боту /id
ADMIN_CHAT_ID=
PORT=3000
# 1, если сервер стоит за прокси (Railway, Render) — нужно для лимита заявок по IP
TRUST_PROXY=1
# Папка для данных. На Railway подключите Volume и укажите его путь, например /data. По умолчанию ./data
DATA_DIR=
